# 老师帮后端环境变量示例
# 使用方法：复制本文件为 .env.dev（开发）或 .env.prod（生产），再填写真实值。
# .env.dev / .env.prod 已加入 .gitignore，禁止提交到仓库。
# 生产环境（APP_ENV=prod）必须设置 JWT_SECRET_KEY，否则启动失败；可用 `python -c "import secrets;print(secrets.token_hex(32))"` 生成。
# 生产环境请设置 APP_ENV = 'prod'、APP_ROOT_PATH = '/prod-api'、APP_RELOAD = false、DB_ECHO = false。

# -------- 应用配置 --------
# 应用运行环境
APP_ENV = 'dev'
# 应用名称
APP_NAME = 'RuoYi-FastAPI'
# 应用代理路径
APP_ROOT_PATH = '/dev-api'
# 应用主机
APP_HOST = '0.0.0.0'
# 应用端口
APP_PORT = 9099
# 应用版本
APP_VERSION= '1.6.2'
# 应用是否开启热重载
APP_RELOAD = true
# 应用是否开启IP归属区域查询
APP_IP_LOCATION_QUERY = true
# 应用是否允许账号同时登录
APP_SAME_TIME_LOGIN = true
# 是否开放 /docs、/redoc、/openapi.json（不设置时：prod 关闭，其他环境开启）
# APP_DOCS_ENABLED = false

# -------- Jwt配置 --------
# Jwt秘钥
JWT_SECRET_KEY = 'CHANGE_ME_TO_A_RANDOM_64_HEX_SECRET'
# Jwt算法
JWT_ALGORITHM = 'HS256'
# 令牌过期时间
JWT_EXPIRE_MINUTES = 1440
# redis中令牌过期时间
JWT_REDIS_EXPIRE_MINUTES = 30


# -------- 数据库配置 --------
# 数据库类型，可选的有'mysql'、'postgresql'，默认为'mysql'
DB_TYPE = 'mysql'
# 数据库主机
DB_HOST = '127.0.0.1'
# 数据库端口
DB_PORT = 3306
# 数据库用户名
DB_USERNAME = 'teacher_help'
# 数据库密码
DB_PASSWORD = 'CHANGE_ME'
# 数据库名称
DB_DATABASE = 'ruoyi-fastapi'
# 是否开启sqlalchemy日志
DB_ECHO = false
# 允许溢出连接池大小的最大连接数
DB_MAX_OVERFLOW = 10
# 连接池大小，0表示连接数无限制
DB_POOL_SIZE = 50
# 连接回收时间（单位：秒）
DB_POOL_RECYCLE = 3600
# 连接池中没有线程可用时，最多等待的时间（单位：秒）
DB_POOL_TIMEOUT = 30
# 启动时是否自动 create_all + 补列 ALTER（不设置时：prod 关闭，其他环境开启）
# 生产环境请保持关闭，表结构变更使用 `python sql/migrate.py --env=prod up`
# DB_AUTO_INIT = false

# -------- Redis配置 --------
# Redis主机
REDIS_HOST = '127.0.0.1'
# Redis端口
REDIS_PORT = 6379
# Redis用户名
REDIS_USERNAME = ''
# Redis密码
REDIS_PASSWORD = 'CHANGE_ME'
# Redis数据库
REDIS_DATABASE = 2

# -------- 业务规则开关（P2，待产品确认，默认保持保守行为） --------
# 场地折扣卡折扣率口径：auto（0<r<=1 为比例、1<r<=10 为几折）/ ratio（只接受比例）/ zhe（只接受几折）
CARD_DISCOUNT_RATE_MODE = 'auto'
# 预订/锁场是否必须落在场地可约时段内
VENUE_BOOKING_REQUIRE_OPEN_TIME = false
# 批量锁场单次最多生成的记录数（日期数 x 场地数）
VENUE_LOCK_BATCH_MAX = 500
